

# The per-race control table used to live here as a `shared avatar_widgets` dict. It is
# gone: `faces.FACE_FEATURES` is generated from the layer tables, so the editor cannot
# disagree with the art it is editing. The 2026-09 sheet redraw is what settled that -
# this copy had gone stale in five separate places without anybody noticing, because a
# wrong control does not fail, it just edits the wrong thing.

shared race = "terran"
shared avatar_cur = []
shared avatar_enable = []
avatar_cur, avatar_enable = char_editor_defaults(race)
face_text = ""


===== avatar_editor_show
# Title bar
    copy_clipboard(char_editor_build_face(race, avatar_enable, avatar_cur))

    gui_section("area:0,0,100,100;")
    gui_row("row-height:2em;background: #1573")
    gui_text("text:AVATAR EDITOR; font:gui-3;justify: center;")
    ib = gui_icon("icon_index:137;color:white;", style="click_color:white;click_tag:menu;click_background:#6666")
    on gui_click(ib):
        jump server_start


    gui_section(style="area: 10, 13, 100, 20;")

    gui_text("The face code is copied to the clipboard whenever changes are made.")

    gui_section(style="area: 0, 20,100-400px, 100;")
    the_face = gui_face(char_editor_build_face(race, avatar_enable, avatar_cur))

    gui_section(style="area: 100-400px, 20, 100, 60+2em;row-height:2em;")

    race_pick = gui_drop_down("text:{race.capitalize()};list: Arvonian, Kralien, Skaraan, Terran, Torgoth, Ximni", var="race")
    on gui_message(race_pick):
        race = race.lower()
        # Sized for the NEW race. The lists used to be a fixed ten entries whatever the
        # race, so switching to one with fewer controls left another race's values in the
        # tail and fed them straight back into the builder.
        avatar_cur, avatar_enable = char_editor_defaults(race)
        jump avatar_editor_show

    gui_row()

    gui_section(style="area: 100-400px, 30, 100, 100;row-height:2em;")

    widgets = char_editor_features(race)

    jump config_error if not widgets

    widget_style = "padding:10px,5px,5px,10px;"
    # `i` is the feature's own index now. It used to be bumped by hand before or after
    # the body of the loop depending on the race, to skip the face_id argument the old
    # per-race builders took - build_face has no such slot.
    for i, widget in enumerate(widgets):
        gui_row( style="padding: 1px;")
        label = widget["label"]
        wmax = widget["max"]
        wnames = widget.get("names")
        if "optional" in widget:
            enable = avatar_enable[i]
            cb = gui_checkbox("text: {label};state:{enable}", widget_style, data={"windex": i})
            cb.value = enable
            on gui_message(cb):
                avatar_enable[windex] = not avatar_enable[windex]
                the_face.value = copy_clipboard(char_editor_build_face(race, avatar_enable, avatar_cur))

            # A feature with NAMES gets a dropdown when the list is SHORT, and a slider
            # with its name written beside it when it is long - a dropdown stops being
            # usable in the engine around ten entries and the skin palette is 39 tones.
            if wnames and not char_editor_use_slider(wnames):
                dd = gui_drop_down(char_editor_choice_style(wnames, avatar_cur[i]), widget_style, data={"windex": i, "wpick": wnames})
                on gui_message(dd):
                    avatar_cur[windex] = char_editor_choice_index(wpick, __ITEM__.value)
                    the_face.value = copy_clipboard(char_editor_build_face(race, avatar_enable, avatar_cur))
            elif wmax > 0:
                sl = gui_int_slider("low: 0; high: {wmax};", widget_style, data={"windex": i})
                sl.value = avatar_cur[i]
                on gui_message(sl):
                    avatar_cur[windex] = __ITEM__.value
                    the_face.value = copy_clipboard(char_editor_build_face(race, avatar_enable, avatar_cur))
        else:
            # The label widget carries "Feature: Name" so a long named list can be a
            # slider and still say what it is on. It travels through `data` rather than
            # being referenced directly: every row's handler is compiled in this same
            # loop, so a bare `nm` would resolve to the LAST row's widget and every
            # slider would rename the bottom one.
            if wnames and char_editor_use_slider(wnames):
                nm = gui_text(char_editor_choice_label(label, wnames, avatar_cur[i]))
                sl = gui_int_slider("low: 0; high: {wmax}; show_number: no", widget_style, data={"windex": i, "wpick": wnames, "wlabel": nm, "wtitle": label})
                sl.value = avatar_cur[i]
                on gui_message(sl):
                    avatar_cur[windex] = __ITEM__.value
                    wlabel.value = char_editor_choice_label(wtitle, wpick, __ITEM__.value)
                    the_face.value = copy_clipboard(char_editor_build_face(race, avatar_enable, avatar_cur))
            else:
                """text:{label}"""
                if wnames:
                    dd = gui_drop_down(char_editor_choice_style(wnames, avatar_cur[i]), widget_style, data={"windex": i, "wpick": wnames})
                    on gui_message(dd):
                        avatar_cur[windex] = char_editor_choice_index(wpick, __ITEM__.value)
                        the_face.value = copy_clipboard(char_editor_build_face(race, avatar_enable, avatar_cur))
                else:
                    sl = gui_int_slider("low: 0; high: {wmax}; show_number: no", widget_style, data={"windex": i})
                    sl.value = avatar_cur[i]
                    on gui_message(sl):
                        avatar_cur[windex] = __ITEM__.value
                        the_face.value = copy_clipboard(char_editor_build_face(race, avatar_enable, avatar_cur))


    await gui()


========= config_error =========
    gui_section(style="area: 35, 5, 65, 10;")
    """ Data is messed up """

    await gui()
